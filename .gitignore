# Python caches
__pycache__/
*.py[cod]

# Local environments and tool caches
env/
venv/
.venv/
.mplconfig/
.pytest_cache/

# Local machine-specific runner config
machines.local.json

# Generated simulation/training outputs
checkpoints/
logs/
results/
outputsfull/
jaxresults/
MDresults/
expand/
reading/
fairchem/
codes/*/expand/

# Track generated BlueHive ORCA parity inputs/scripts for transfer to cluster.
!codes/A_parityplot/8_5_bluehiveDFT/expand/
!codes/A_parityplot/8_5_bluehiveDFT/expand/**

# Large model/checkpoint artifacts
*.model
*.pt
*.pth
*.ckpt

# Slurm/runtime logs
slurm-*.out
slurm-*.err

# ORCA scratch/generated files
*.gbw
*.ges
*.densities
*.densitiesinfo
*.bibtex
*.property.txt
*.pdf
*.tmp
*.tmp.*
*.hostnames
*.engrad

# Track all files in this analysis directory, including files that match
# generated-output patterns above.
!codes/8_7_H2DFTanalysis/
!codes/8_7_H2DFTanalysis/**
