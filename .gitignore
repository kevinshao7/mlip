# Python caches
__pycache__/
*.py[cod]

# Local environments and tool caches
env/
venv/
.venv/
.mplconfig/
.pytest_cache/

# Local machine-specific runner config
machines.local.json

# Generated simulation/training outputs
checkpoints/
logs/
results/
outputsfull/*
jaxresults/
MDresults/
expand/
reading/
fairchem/
codes/*/expand/

# Track generated BlueHive ORCA parity inputs/scripts for transfer to cluster.
!codes/A_parityplot/8_5_bluehiveDFT/expand/
!codes/A_parityplot/8_5_bluehiveDFT/expand/**

# Track C3 production stop-H2 clusters and generated ORCA inputs/scripts for HPC transfer.
!outputsfull/
!outputsfull/C3_DFTproductionstopH2/
outputsfull/C3_DFTproductionstopH2/*
!outputsfull/C3_DFTproductionstopH2/condition_production_stopH2_clusters.xyz
!outputsfull/C3_DFTproductionstopH2/condition_production_stopH2_clusters_summary.csv
!outputsfull/C3_DFTproductionstopH2/condition_production_stopH2_stage_windows.csv
!codes/C3_DFTproductionstopH2/expand/
!codes/C3_DFTproductionstopH2/expand/**

# Large model/checkpoint artifacts
*.model
*.pt
*.pth
*.ckpt

# Slurm/runtime logs
slurm-*.out
slurm-*.err

