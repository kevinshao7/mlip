cat > .gitignore <<'EOF'
# training outputs
checkpoints/
logs/
results/

# MACE/model outputs
*checkpoints/*
*.model
*.pt
*.pth
*expand/*
# large generated data
*outputsfull/*


#folders
*aseMolec/*
*mace/*
# Python/env
__pycache__/
*.pyc
*orca/*
jaxresults/
env/
venv/
.venv/
.mplconfig/
EOF
expand/
